plot_data
colnames(plot_data) <- c("patient", "dens_1", "dens_2", "dens_3", "dens_4")
plot_data |>
pivot_longer(-patient, names_to = "measure", values_to = "density") |>
separate(measure, into = c("dens", "num_measure"), sep = "_") |>
select(-dens) |>
ggplot(aes(x = patient, y = density, group = num_measure)) +
geom_point() +
stat_summary(fun=mean, colour="red", geom="line", aes(group = 1)) +
theme_classic() +
scale_x_continuous(limits = c(0, 20), breaks = 1:20) +
xlab("Patient") + ylab("Bone density")
jaw_long <- plot_data |>
pivot_longer(-patient, names_to = "measure", values_to = "density") |>
mutate(patient = factor(patient))
priors1 <- set_prior("normal(0,100)", class = "Intercept")
fit1 <- brm(
density ~ 1 + (1 | patient),
data    = jaw_long,
family  = gaussian(),
prior   = priors1,
chains  = 2,
iter    = 7000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
draws1 <- as_draws_df(fit1)
sigma2 <- draws1 |>
transmute(sigmae = sigma^2, sigmaa = sd_patient__Intercept^2)
mu    <- draws1$b_Intercept
alpha <- ranef(fit1, summary = FALSE)$patient[, , "Intercept"] |>
as.data.frame()
colnames(alpha) <- paste0("alpha_", 1:20)
alpha <- sweep(alpha, 1, mu, "+")   # patient-specific means = mu + random intercept
r <- sigma2$sigmaa / (sigma2$sigmae + sigma2$sigmaa)
r |>
data.frame() |>
ggplot(aes(x = r, after_stat(density))) +
geom_histogram(fill = "grey", color = "black", bins = 50) +
theme_classic() +
xlab("Proportion of variance explained by the random effect") +
ylab("Probability")
alpha |>
pivot_longer(alpha_1:alpha_20,names_to = "alpha", values_to = "values") |>
separate(alpha, into = c("coef", "patient"), sep = "_") |>
select(-coef) |>
ggplot(aes(x = patient, y = values)) +
geom_boxplot(fill = "lightgrey") +
theme_classic() +
xlab("Patient") + ylab("Bone density")
priors2 <- c(
set_prior("normal(0,100)", class = "Intercept"),
set_prior("cauchy(0,1)",   class = "sd"),
set_prior("cauchy(0,1)",   class = "sigma")
)
fit_hc <- brm(
density ~ 1 + (1 | patient),
data    = jaw_long,
family  = gaussian(),
prior   = priors2,
chains  = 2,
iter    = 7000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
draws_hc <- as_draws_df(fit_hc)
sigma2HC <- draws_hc |>
transmute(sigmae = sigma^2, sigmaa = sd_patient__Intercept^2)
quantile(sqrt(sigma2$sigmae),c(0.5,0.025,0.975))   # Variant 1 (default sigma/sd priors), error SD
quantile(sqrt(sigma2$sigmaa),c(0.5,0.025,0.975))   # Variant 1, random-effect SD
quantile(sqrt(sigma2HC$sigmae),c(0.5,0.025,0.975)) # Half-Cauchy prior, error SD
quantile(sqrt(sigma2HC$sigmaa),c(0.5,0.025,0.975)) # Half-Cauchy prior, random-effect SD
error_sd <- data.frame(sigma2 = sigma2$sigmae, sigma2HC = sigma2HC$sigmae)
error_sd |>
pivot_longer(sigma2:sigma2HC, names_to = "sigma", values_to = "values") |>
ggplot(aes(x = values, group = sigma)) +
geom_density(aes(fill = sigma), alpha = 0.35) +
scale_fill_manual(values = c("blue", "red"),
labels = c("Default (variant 1)", "Half-Cauchy")) +
theme(legend.title = element_blank()) +
ggtitle("Error SD") +
xlab(expression(sigma))+ylab("Posterior density")+
theme_classic()
random_sd <- data.frame(sigma2 = sigma2$sigmaa, sigma2HC = sigma2HC$sigmaa)
random_sd |>
pivot_longer(sigma2:sigma2HC, names_to = "sigma", values_to = "values") |>
ggplot(aes(x = values, group = sigma)) +
geom_density(aes(fill = sigma), alpha = 0.35) +
scale_fill_manual(values = c("blue", "red"),
labels = c("Default (variant 1)", "Half-Cauchy")) +
theme(legend.title = element_blank()) +
ggtitle("Random effect SD") +
xlab(expression(sigma))+ylab("Posterior density")+
theme_classic()
