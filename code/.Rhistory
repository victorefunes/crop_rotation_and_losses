na.omit() |>
data.frame() ->
data_raw
data_raw %>%
feols(log_species~house+bedrooms+elev+lat+long+temp+precip+NPP,
data = .) ->
ols_fit
etable(ols_fit)
bayes_fit <- brm(log_species~house+bedrooms+elev+lat+long+temp+precip+NPP,
