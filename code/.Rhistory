colnames(X) <- paste0("Xmile", 1:p)
df <- data.frame(Y = as.numeric(Y), X)
miss_cols <- names(df)[-1][colSums(is.na(df[,-1])) > 0]
# Outcome model: Y regressed on the (possibly-imputed) mile speeds
outcome_form <- bf(as.formula(
paste("Y ~", paste0("mi(", names(df)[-1], ")", collapse = " + "))
))
# One independent imputation submodel per mile with missing values
submodels <- lapply(miss_cols, function(v) {
bf(as.formula(paste(v, "| mi() ~ 1")))
})
full_form <- Reduce(`+`, c(list(outcome_form), submodels)) + set_rescor(FALSE)
priors <- c(
set_prior("normal(0,10)", class = "b",         resp = "Y"),
set_prior("normal(0,10)", class = "Intercept", resp = "Y")
)
fit <- brm(
full_form,
data    = df,
family  = gaussian(),
prior   = priors,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0,
control = list(adapt_delta = 0.95)
)
colnames(X) <- paste0("Xmile", 1:p)
df <- data.frame(Y = as.numeric(Y), X)
miss_cols <- names(df)[-1][colSums(is.na(df[,-1])) > 0]
obs_cols  <- setdiff(names(df)[-1], miss_cols)
# Outcome model: Y regressed on the mile speeds. Only miles with at least
# one NA are wrapped in mi() -- brms requires every mi()-wrapped variable
# to also appear as a response in one of the submodels below, so
# fully-observed miles are entered directly instead.
outcome_terms <- c(paste0("mi(", miss_cols, ")"), obs_cols)
outcome_form  <- bf(as.formula(
paste("Y ~", paste(outcome_terms, collapse = " + "))
))
# One independent imputation submodel per mile with missing values
submodels <- lapply(miss_cols, function(v) {
bf(as.formula(paste(v, "| mi() ~ 1")))
})
full_form <- Reduce(`+`, c(list(outcome_form), submodels)) + set_rescor(FALSE)
priors <- c(
set_prior("normal(0,10)", class = "b",         resp = "Y"),
set_prior("normal(0,10)", class = "Intercept", resp = "Y")
)
fit <- brm(
full_form,
data    = df,
family  = gaussian(),
prior   = priors,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0,
control = list(adapt_delta = 0.95)
)
summary(fit)
mcmc_trace(fit, variable = "^b_Y_", regex = TRUE)
draws_df <- as_draws_df(fit)
get_Ymi <- function(resp, row) {
nm <- paste0("Ymi_", resp, "[", row, "]")
if (nm %in% names(draws_df)) draws_df[[nm]] else rep(NA_real_, nrow(draws_df))
}
X_miss <- cbind(
get_Ymi("Xmile6", 3),  get_Ymi("Xmile7", 3),
get_Ymi("Xmile19", 149), get_Ymi("Xmile20", 149), get_Ymi("Xmile21", 149)
)
r <- range(na.omit(as.vector(X)))
# Runner 3
plot(X[3,],ylim=r,
xlab="Mile",ylab="Speed (minute/mile)",
main="Imputed X for two runners")
boxplot(X_miss[,1],at=6,outline=FALSE,add=TRUE)
boxplot(X_miss[,2],at=7,outline=FALSE,add=TRUE)
# Runner 149
points(X[149,],pch=19)
boxplot(X_miss[,3],at=19,col=1,outline=FALSE,add=TRUE)
boxplot(X_miss[,4],at=20,col=1,outline=FALSE,add=TRUE)
boxplot(X_miss[,5],at=21,col=1,outline=FALSE,add=TRUE)
legend("topleft",c("Runner 3","Runner 149"),pch=c(1,19),bty="n",cex=1.5)
