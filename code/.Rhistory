library(brms)
library(posterior)
library(bayesplot)
library(tidyverse)
options(mc.cores = parallel::detectCores())
set.seed(0820)
Y <- c(64, 72, 55, 27, 75, 24, 28, 66, 40, 13)
N <- c(75, 95, 63, 39, 83, 26, 41, 82, 54, 16)
q <- c(0.845, 0.847, 0.880, 0.674, 0.909, 0.899, 0.770, 0.801, 0.802, 0.875)
X <- log(q)-log(1-q) # X = logit(q)
n <- length(Y)
df <- data.frame(Y, N, X)
inits   <- c("RW","JH","KL","LJ","SC","IT","GA","JW","AD","KD")
plot_df <- data.frame(inits, Y, N, q)
plot_df |>
mutate(overall_pct = 100*q,
clutch_pct = 100*Y/N) |>
ggplot(aes(x = overall_pct, y = clutch_pct)) +
geom_point(size = 2) +
geom_text(aes(label = inits), size = 4, vjust = 0, nudge_y = 0.5) +
geom_smooth(method = "lm", se = FALSE) +
theme_classic() +
xlab("Overall percentage") + ylab("Clutch percentage")
priors1 <- c(
set_prior("normal(0,10)", class = "b"),
set_prior("normal(0,10)", class = "Intercept")
)
fit1 <- brm(
Y | trials(N) ~ X,
data    = df,
family  = binomial(link = "logit"),
prior   = priors1,
chains  = 2,
iter    = 30000,
warmup  = 10000,
seed    = 0820,
refresh = 0
)
summary(fit1)
mcmc_trace(fit1, variable = c("b_Intercept", "b_X"))
mcmc_hist(fit1, variable = c("b_Intercept", "b_X"))
priors2 <- set_prior("normal(0,10)", class = "Intercept")
fit2 <- brm(
Y | trials(N) ~ 1 + offset(X),
data    = df,
family  = binomial(link = "logit"),
prior   = priors2,
chains  = 2,
iter    = 30000,
warmup  = 10000,
seed    = 0820,
refresh = 0
)
summary(fit2)
mcmc_trace(fit2, variable = "b_Intercept")
mcmc_hist(fit2, variable = "b_Intercept")
draws1 <- as_draws_matrix(fit1, variable = c("b_Intercept", "b_X"))
draws2 <- as_draws_matrix(fit2, variable = "b_Intercept")
coefs <- data.frame(b1 = draws1[, "b_Intercept"],
b2 = draws1[, "b_X"],
b3 = draws2[, "b_Intercept"])
mean(coefs$b3<0) # Prob(beta_3<0|Y)
coefs
draws1 <- as_draws_matrix(fit1, variable = c("b_Intercept", "b_X"))
draws2 <- as_draws_matrix(fit2, variable = "b_Intercept")
coefs <- data.frame(b1 = draws1[, "b_Intercept"] |> as.numeric(),
b2 = draws1[, "b_X"] |> as.numeric(),
b3 = draws2[, "b_Intercept"] |> as.numeric())
head(coefs)
mean(coefs$b3<0) # Prob(beta_3<0|Y)
coefs |>
pivot_longer(b1:b3, names_to = "coefficients", values_to = "values") |>
ggplot(aes(x = values, group = coefficients)) +
geom_density(aes(fill = coefficients), alpha = 0.35) +
scale_fill_manual(values = c("blue", "red", "green"),
labels = c("Model 1 - Intercept","Model 1 - Slope","Model 2 - Intercept")) +
theme(legend.title = element_blank()) +
xlab(expression(beta))+ylab("Posterior density")+
theme_classic()
library(brms)
library(bayesplot)
library(tidyverse)
library(tidybayes)
options(mc.cores = parallel::detectCores())
# Load data
load("C:/Users/vf006/Box/Course materials/STAT 431/Replication/homes.RData")
homes <- homes |>
rename(lat = Latitude,
long = Longitude,
temp = MeanAnnual.Temperature,
precip = MeanAnnualPrecipitation,
NPP = NetPrimaryProductivity,
elev = Elevation,
city = City,
state = State) |>
mutate(house = ifelse(Residence == "One-family house detached from any other house", 1, 0),
bedrooms = as.numeric(NumberBedroooms)) |>
select(-c(NumberBedroooms, Residence))
OTU      <- as.matrix(OTU)
nspecies <- rowSums(OTU>0)
homes
Y <- log(nspecies)
X <- homes |>
select(c(lat, long, temp, precip, NPP, elev, house, bedrooms)) |>
data.frame()
# Remove observations with missing data
junk     <- is.na(rowSums(X))
Y        <- Y[!junk]
X        <- X[!junk,]
city     <- homes$city[!junk]
state    <- homes$state[!junk]
# Standardize the covariates
X        <- as.matrix(scale(X))
names <- c("Longitude","Latitude", "Temperature","Precipitation","NPP",
"Elevation","Single-family home", "Number of bedrooms")
colnames(X) <- names
data <- data.frame(log_species = Y, X)
library(maps)
map("state")
points(homes[,5],homes[,4],pch=19,cex=.5)
title("Sample locations")
form <- bf(log_species ~ Longitude + Latitude + Temperature + Precipitation +
NPP + Elevation + Single.family.home + Number.of.bedrooms)
priors1 <- c(
set_prior("normal(0,31.6)", class = "b"),
set_prior("normal(0,31.6)", class = "Intercept")
)
fit1 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors1,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
mcmc_trace(fit1, variable = "^b_", regex = TRUE)
fit1
mcmc_trace(fit1, variable = names, regex = TRUE)
help(mcmc_trace)
names
mcmc_trace(fit1, variable = "Longitude", regex = TRUE)
mcmc_trace(fit1, regex_pars = "^b_")
summary(fit1)
priors2 <- set_prior(horseshoe(df = 3, par_ratio = 0.5), class = "b")
fit2 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors2,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0,
control = list(adapt_delta = 0.99)
)
mcmc_trace(fit2, regex_pars = "^b_")
summary(fit2)
priors3 <- set_prior(lasso(df = 1, scale = 10), class = "b")
priors3 <- set_prior("double_exponential(0, 10)", class = "b")
fit3 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors3,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
mcmc_trace(fit3, regex_pars = "^b_")
summary(fit3)
b1 <- as_draws_df(fit1, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
b2 <- as_draws_df(fit2, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
b3 <- as_draws_df(fit3, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
colnames(b1) <- colnames(b2) <- colnames(b3) <- names
df <- rbind(
cbind(model = "Uninformative gaussian", b1),
cbind(model = "Gaussian shrinkage (horseshoe)", b2),
cbind(model = "Laplace prior",          b3)
)
df |>
pivot_longer(-model, names_to = "variable", values_to = "beta") |>
ggplot(aes(x = beta)) +
geom_density(aes(fill = model), alpha = 0.25) +
geom_vline(xintercept = 0) +
theme_classic() +
facet_wrap(.~variable, scales = "free")
library(fixest)
library(broom)
library(broom.mixed)
library(modelr)
library(marginaleffects)
homes |>
mutate(log_species = log(nspecies)) |>
select(c(lat, long, temp, precip, NPP, elev, house, bedrooms, log_species)) |>
na.omit() |>
data.frame() ->
data_raw
data_raw %>%
feols(log_species~house+bedrooms+elev+lat+long+temp+precip+NPP,
data = .) ->
ols_fit
etable(ols_fit)
bayes_fit <- brm(log_species~house+bedrooms+elev+lat+long+temp+precip+NPP,
data = data_raw)
mcmc_plot(bayes_fit, type = "dens")
bayes_fit |>
gather_draws(c(b_house, b_bedrooms, b_temp, b_precip)) |>
ggplot(aes(x = .value, y = fct_rev(.variable), fill = .variable)) +
geom_vline(xintercept = 0) +
theme_bw() +
stat_halfeye(.width = c(0.1, 0.95), alpha = 0.8, point_interval = "median_hdi") +
guides(fill = "none") +
labs(x = "Coefficient", y = "Variable",
caption = "80% and 95% credible intervals shown in black")
priors <- set_prior("normal(0, 0.001)", class = "b")
bayes_fit2 <- brm(log_species~house+bedrooms+elev+lat+long+temp+precip+NPP,
data = data_raw,
prior = priors)
tidy(bayes_fit2)
gc()
shiny::runApp('C:/Users/vf006/Box/premiums/NPV_sims/risk_model/app')
