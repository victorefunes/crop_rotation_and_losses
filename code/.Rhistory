# Remove observations with missing data
junk     <- is.na(rowSums(X))
Y        <- Y[!junk]
X        <- X[!junk,]
city     <- homes$city[!junk]
state    <- homes$state[!junk]
# Standardize the covariates
X        <- as.matrix(scale(X))
names <- c("Longitude","Latitude", "Temperature","Precipitation","NPP",
"Elevation","Single-family home", "Number of bedrooms")
colnames(X) <- names
data <- data.frame(log_species = Y, X)
library(maps)
map("state")
points(homes[,5],homes[,4],pch=19,cex=.5)
title("Sample locations")
form <- bf(log_species ~ Longitude + Latitude + Temperature + Precipitation +
NPP + Elevation + Single.family.home + Number.of.bedrooms)
priors1 <- c(
set_prior("normal(0,31.6)", class = "b"),
set_prior("normal(0,31.6)", class = "Intercept")
)
fit1 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors1,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
mcmc_trace(fit1, variable = "^b_", regex = TRUE)
fit1
mcmc_trace(fit1, variable = names, regex = TRUE)
help(mcmc_trace)
names
mcmc_trace(fit1, variable = "Longitude", regex = TRUE)
mcmc_trace(fit1, regex_pars = "^b_")
summary(fit1)
priors2 <- set_prior(horseshoe(df = 3, par_ratio = 0.5), class = "b")
fit2 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors2,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0,
control = list(adapt_delta = 0.99)
)
mcmc_trace(fit2, regex_pars = "^b_")
summary(fit2)
priors3 <- set_prior(lasso(df = 1, scale = 10), class = "b")
priors3 <- set_prior("double_exponential(0, 10)", class = "b")
fit3 <- brm(
form,
data    = data,
family  = gaussian(),
prior   = priors3,
chains  = 2,
iter    = 5000,
warmup  = 2000,
seed    = 0820,
refresh = 0
)
mcmc_trace(fit3, regex_pars = "^b_")
summary(fit3)
b1 <- as_draws_df(fit1, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
b2 <- as_draws_df(fit2, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
b3 <- as_draws_df(fit3, variable = "^b_", regex = TRUE) |> select(starts_with("b_"), -b_Intercept)
colnames(b1) <- colnames(b2) <- colnames(b3) <- names
df <- rbind(
cbind(model = "Uninformative gaussian", b1),
cbind(model = "Gaussian shrinkage (horseshoe)", b2),
cbind(model = "Laplace prior",          b3)
)
df |>
pivot_longer(-model, names_to = "variable", values_to = "beta") |>
ggplot(aes(x = beta)) +
geom_density(aes(fill = model), alpha = 0.25) +
geom_vline(xintercept = 0) +
theme_classic() +
facet_wrap(.~variable, scales = "free")
library(fixest)
